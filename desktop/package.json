{
  "name": "clipforge",
  "productName": "ClipForge",
  "version": "1.0.0",
  "description": "Clips et montage vidéo, 100 % sur ton PC",
  "license": "SEE LICENSE IN LICENSE",
  "author": "nono-rsb",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clipforge.app",
    "productName": "ClipForge",
    "copyright": "© 2026 nono-rsb. Tous droits réservés.",
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json",
      {
        "from": "..",
        "to": ".",
        "filter": [
          "index.html",
          "legal.html",
          "styles.css",
          "manifest.webmanifest",
          "js/**",
          "icons/**",
          "server.js"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipForge",
      "artifactName": "ClipForge-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nono-rsb",
        "repo": "clipforge"
      }
    ]
  }
}
